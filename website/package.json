{
  "name": "brundlefly-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node scripts/sync-brand.ts && nuxt dev",
    "build": "node scripts/sync-brand.ts && nuxt generate && cf build",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test test/*.test.ts",
    "preview:cloudflare": "vite --host 127.0.0.1",
    "check": "pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.0.0",
    "@vueuse/core": "^14.0.0",
    "nuxt": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@types/node": "^24.0.0",
    "cf": "1.0.0-beta.5",
    "fflate": "^0.8.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vue-tsc": "^3.0.0"
  }
}
